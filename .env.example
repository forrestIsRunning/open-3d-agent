# Copy to .env. Never commit .env.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://lumina.tripo3d.com/v1
MODEL=gpt-5.6-luna
PROVIDER=lumina

# Absolute path. Required for blender skill.
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender

# Isolated from ~/.codex
CODEX_HOME=

# never | on-request
APPROVAL_POLICY=never
